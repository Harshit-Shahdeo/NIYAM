# ==============================
# NIYAM AI SERVICE CONFIGURATION
# ==============================

# PostgreSQL / pgvector
DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/niyam

DB_HOST=localhost
DB_PORT=5432
DB_NAME=niyam
DB_USER=postgres
DB_PASSWORD=YOUR_DB_PASSWORD

# ==============================
# LLM CONFIGURATION
# ==============================

# Current LLM provider mode
LLM_MODE=live

# Groq API key
GROQ_API_KEY=YOUR_GROQ_API_KEY

# Optional: required only if using OpenAI mode
OPENAI_API_KEY=
