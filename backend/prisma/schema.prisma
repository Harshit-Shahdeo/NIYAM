generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  FACULTY
  ADMIN
}

enum ServiceRequestStatus {
  RECEIVED
  PROCESSING
  WAITING_FOR_APPROVAL
  APPROVED
  REJECTED
  COMPLETED
  FAILED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  MORE_INFO_REQUIRED
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

enum ResourceType {
  LAB
  CLASSROOM
  SEMINAR_HALL
  EQUIPMENT
  OTHER
}

enum AuditEventType {
  REQUEST_RECEIVED
  AI_REASONING_STARTED
  AI_REASONING_COMPLETED
  POLICY_RETRIEVED
  POLICY_CONFLICT_DETECTED
  ACTION_PROPOSED
  APPROVAL_REQUESTED
  APPROVAL_GRANTED
  APPROVAL_REJECTED
  MORE_INFORMATION_REQUESTED
  ACTION_EXECUTED
  BOOKING_CREATED
  REQUEST_COMPLETED
  REQUEST_FAILED
  ACTION_EXECUTION_FAILED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model Institution {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  departments     Department[]
  users           User[]
  studentProfiles StudentProfile[]
  resources       Resource[]
  serviceRequests ServiceRequest[]
  bookings        Booking[]
  approvals       Approval[]
  auditEvents     AuditEvent[]
  conversations   Conversation[]
  semesterResults SemesterResult[]
}

model Department {
  id            String @id @default(uuid())
  institutionId String
  name          String
  code          String

  institution     Institution      @relation(fields: [institutionId], references: [id])
  users           User[]
  studentProfiles StudentProfile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([institutionId, code])
  @@index([institutionId])
}

model User {
  id            String  @id @default(uuid())
  institutionId String
  departmentId  String?

  name         String
  email        String
  role         UserRole
  passwordHash String
  isActive     Boolean  @default(true)

  institution Institution @relation(fields: [institutionId], references: [id])
  department  Department? @relation(fields: [departmentId], references: [id])

  studentProfile StudentProfile?

  serviceRequests ServiceRequest[]
  bookings        Booking[]
  approvals       Approval[]
  auditEvents     AuditEvent[]

  conversations Conversation[]
  messages      Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([institutionId, email])
  @@index([institutionId])
  @@index([departmentId])
}

model StudentProfile {
  id String @id @default(uuid())

  institutionId String
  userId        String  @unique
  departmentId  String?

  enrollmentNumber String

  program  String?
  semester Int?

  cgpa                 Decimal? @db.Decimal(4, 2)
  attendancePercentage Decimal? @db.Decimal(5, 2)

  institution Institution @relation(fields: [institutionId], references: [id])
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  department  Department? @relation(fields: [departmentId], references: [id])
  semesterResults SemesterResult[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([institutionId, enrollmentNumber])
  @@index([institutionId])
  @@index([departmentId])
}

model Resource {
  id            String @id @default(uuid())
  institutionId String

  name     String
  type     ResourceType
  location String?
  capacity Int?

  institution Institution @relation(fields: [institutionId], references: [id])
  bookings    Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([institutionId, name])
  @@index([institutionId])
}

model ServiceRequest {
  id            String @id @default(uuid())
  externalId    String @unique
  institutionId String
  userId        String

  conversationId String?

  message String
  intent  String?
  status  ServiceRequestStatus @default(RECEIVED)

  institution Institution @relation(fields: [institutionId], references: [id])
  user        User        @relation(fields: [userId], references: [id])

conversation Conversation? @relation(fields: [conversationId], references: [id])

  booking     Booking?
  approval    Approval?
  auditEvents AuditEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([institutionId])
  @@index([userId])
  @@index([status])
  @@index([conversationId])

}

model Booking {
  id            String @id @default(uuid())
  institutionId String
  resourceId    String
  userId        String
  requestId     String @unique

  date      DateTime
  startTime DateTime
  endTime   DateTime
  purpose   String?
  status    BookingStatus @default(CONFIRMED)

  institution Institution    @relation(fields: [institutionId], references: [id])
  resource    Resource       @relation(fields: [resourceId], references: [id])
  user        User           @relation(fields: [userId], references: [id])
  request     ServiceRequest @relation(fields: [requestId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([institutionId])
  @@index([resourceId, date])
  @@index([userId])
}

model Approval {
  id            String  @id @default(uuid())
  institutionId String
  requestId     String  @unique
  approverId    String?

  status     ApprovalStatus @default(PENDING)
  reason     String?
  resolvedAt DateTime?

  institution Institution    @relation(fields: [institutionId], references: [id])
  request     ServiceRequest @relation(fields: [requestId], references: [id])
  approver    User?          @relation(fields: [approverId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([institutionId])
  @@index([status])
  @@index([approverId])
}

model AuditEvent {
  id            String  @id @default(uuid())
  institutionId String
  requestId     String
  actorId       String?

  eventType AuditEventType
  metadata  Json?

  institution Institution    @relation(fields: [institutionId], references: [id])
  request     ServiceRequest @relation(fields: [requestId], references: [id])
  actor       User?          @relation(fields: [actorId], references: [id])

  createdAt DateTime @default(now())

  @@index([institutionId])
  @@index([requestId, createdAt])
  @@index([actorId])
}

model PolicyChunk {
  id         String                     @id @default(uuid())
  documentId String
  content    String
  embedding  Unsupported("vector(384)")
  metadata   Json?
  createdAt  DateTime                   @default(now())

  @@index([documentId])
}

model Conversation {
  id            String @id @default(uuid())
  institutionId String
  userId        String

  title String?

  institution Institution @relation(fields: [institutionId], references: [id])
  user        User        @relation(fields: [userId], references: [id])

  messages Message[]

  serviceRequests ServiceRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([institutionId])
  @@index([userId])
  @@index([userId, updatedAt])
}

model Message {
  id             String @id @default(uuid())
  conversationId String
  userId         String

  role    MessageRole
  content String
  metadata Json?

  user User @relation(fields: [userId], references: [id])

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([conversationId, createdAt])
  @@index([userId])
}

model SemesterResult {
  id               String         @id @default(uuid())
  institutionId    String
  studentProfileId String
  semester         Int
  sgpa             Decimal?       @db.Decimal(4, 2)

  institution      Institution    @relation(fields: [institutionId], references: [id])
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  subjects         ResultSubject[]

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([studentProfileId, semester])
  @@index([institutionId])
  @@index([studentProfileId])
}

model ResultSubject {
  id               String         @id @default(uuid())
  semesterResultId String
  courseCode       String
  courseName       String
  credits          Int
  marks            Int
  grade            String

  semesterResult   SemesterResult @relation(fields: [semesterResultId], references: [id], onDelete: Cascade)

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([semesterResultId, courseCode])
  @@index([semesterResultId])
}

